#!/usr/bin/env sh
set -eu

for required in DORIS_FE_HOST DORIS_ADMIN_SECRET DORIS_QUERY_SECRET EXPECTED_QUERY_ID; do
  eval "test -n \"\${$required:-}\""
done
case "$EXPECTED_QUERY_ID" in
  *[!0-9A-Fa-f-]*|'')
    printf '%s\n' '{"goal":"goal-06","operation":"audit-verify","status":"invalid-query-id"}' >&2
    exit 1
    ;;
esac

admin_user="$(printf '%s' "$DORIS_ADMIN_SECRET" | jq -er '.username')"
admin_password="$(printf '%s' "$DORIS_ADMIN_SECRET" | jq -er '.password')"
query_user="$(printf '%s' "$DORIS_QUERY_SECRET" | jq -er '.username')"
case "$query_user" in *[!A-Za-z0-9_]*|'') exit 1 ;; esac

mysql_admin() {
  MYSQL_PWD="$admin_password" mysql --ssl --protocol=TCP \
    --host="$DORIS_FE_HOST" --port=9030 --user="$admin_user" "$@"
}

audit_plugin_output=""
if ! audit_plugin_output="$(mysql_admin --batch --skip-column-names \
  -e "SHOW VARIABLES LIKE 'enable_audit_plugin';" 2>/dev/null)"; then
  printf '%s\n' '{"goal":"goal-06","operation":"audit-verify","status":"audit-plugin-unreadable"}' >&2
  exit 1
fi
audit_plugin_state="$(printf '%s\n' "$audit_plugin_output" \
  | awk -F '\t' '$1 == "enable_audit_plugin" {print $2}')"
case "$audit_plugin_state" in
  1|true|TRUE|on|ON) ;;
  *)
    printf '%s\n' '{"goal":"goal-06","operation":"audit-verify","status":"audit-plugin-disabled"}' >&2
    exit 1
    ;;
esac

if ! audit_log_count="$(mysql_admin --batch --skip-column-names \
  -e 'SELECT COUNT(*) FROM internal.__internal_schema.audit_log;' 2>/dev/null \
  | tail -n 1)"; then
  printf '%s\n' '{"goal":"goal-06","operation":"audit-verify","status":"audit-log-unreadable"}' >&2
  exit 1
fi
case "$audit_log_count" in
  ''|*[!0-9]*)
    printf '%s\n' '{"goal":"goal-06","operation":"audit-verify","status":"audit-log-unreadable"}' >&2
    exit 1
    ;;
esac
if [ "$audit_log_count" -eq 0 ]; then
  printf '%s\n' '{"goal":"goal-06","operation":"audit-verify","status":"audit-log-empty"}' >&2
  exit 1
fi

audit_row=""
for _ in $(seq 1 20); do
  if ! audit_row="$(mysql_admin --batch --skip-column-names -e "
    SELECT
      query_id,
      IF(user = '$query_user' OR user LIKE '${query_user}@%', 'true', 'false'),
      state,
      query_time,
      IF(stmt LIKE '%ask_david_serving_development.serving_metric_daily%', 'true', 'false'),
      IF(workload_group LIKE '%goal6_readonly%', 'true', 'false')
    FROM internal.__internal_schema.audit_log
    WHERE query_id = '$EXPECTED_QUERY_ID'
    ORDER BY time DESC
    LIMIT 1;" 2>/dev/null)"; then
    printf '%s\n' '{"goal":"goal-06","operation":"audit-verify","status":"audit-log-unreadable"}' >&2
    exit 1
  fi
  [ -n "$audit_row" ] && break
  sleep 3
done
if [ -z "$audit_row" ]; then
  printf '%s\n' '{"goal":"goal-06","operation":"audit-verify","status":"audit-row-not-found"}' >&2
  exit 1
fi

audit_query_id="$(printf '%s\n' "$audit_row" | cut -f1)"
identity_match="$(printf '%s\n' "$audit_row" | cut -f2)"
state="$(printf '%s\n' "$audit_row" | cut -f3)"
query_time_ms="$(printf '%s\n' "$audit_row" | cut -f4)"
target_match="$(printf '%s\n' "$audit_row" | cut -f5)"
workload_group_match="$(printf '%s\n' "$audit_row" | cut -f6)"
case "$query_time_ms" in ''|*[!0-9]*) exit 1 ;; esac
if [ "$audit_query_id" != "$EXPECTED_QUERY_ID" ] || [ "$identity_match" != "true" ] || \
   [ "$state" != "EOF" ] || [ "$target_match" != "true" ] || \
   [ "$workload_group_match" != "true" ]; then
  printf '%s\n' '{"goal":"goal-06","operation":"audit-verify","status":"audit-contract-mismatch"}' >&2
  exit 1
fi

printf '{"goal":"goal-06","operation":"audit-verify","status":"completed","executed_query_id":"%s","identity_match":true,"target_match":true,"state":"EOF","query_time_ms":%s,"workload_group_match":true}\n' \
  "$audit_query_id" "$query_time_ms"
