FROM python:3.12-slim

WORKDIR /app

COPY docker/requirements.goal7-runtime.txt /app/requirements.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r /app/requirements.txt

COPY packages/goal7-runtime/src/ask_david_goal7 /app/ask_david_goal7
COPY opensearch/index-mapping.json /app/opensearch/index-mapping.json

ENV PYTHONPATH=/app

USER 65532:65532
ENTRYPOINT ["python", "-m", "ask_david_goal7.connected_demo"]
