FROM ghcr.io/astral-sh/uv:0.5.24 AS uv

FROM python:3.12-slim

COPY --from=uv /uv /uvx /bin/
WORKDIR /workspace

COPY pyproject.toml uv.lock ./
COPY packages/platform-foundation/pyproject.toml packages/platform-foundation/pyproject.toml
COPY packages/platform-foundation/src packages/platform-foundation/src

RUN uv sync --frozen --no-dev --all-packages

ENV PATH="/workspace/.venv/bin:$PATH"
CMD ["ask-david-validate-environment"]
