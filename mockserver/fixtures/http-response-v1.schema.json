{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask-david.local/schemas/http-response-v1.json",
  "title": "Generic HTTP mock response v1",
  "type": "object",
  "required": ["status", "correlation_id", "payload"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "error"]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
