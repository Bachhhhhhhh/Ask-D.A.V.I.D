# Copy to terraform.tfvars (ignored by Git) and replace all placeholders.
aws_account_id = "123456789012"
aws_region = "ap-southeast-1"
project = "ask-david"
environment = "development"
additional_tags = {
  Owner      = "REPLACE_WITH_APPROVED_OWNER"
  CostCenter = "REPLACE_WITH_APPROVED_COST_CENTER"
}
bucket_name_prefix = "ask-david-example"
vpc_cidr = "10.42.0.0/16"
public_subnet_cidr = "10.42.0.0/24"
application_subnet_cidrs = ["10.42.16.0/20", "10.42.32.0/20"]
data_subnet_cidrs = ["10.42.64.0/20", "10.42.80.0/20"]
availability_zones = ["ap-southeast-1a", "ap-southeast-1b"]
internal_ingress_cidrs = ["10.42.0.0/16"]
rds_instance_class = "db.t4g.micro"
redis_node_type = "cache.t4g.micro"
rds_deletion_protection = true
rds_skip_final_snapshot = false
log_retention_days = 30
rds_cpu_alarm_threshold_percent = 90
enable_opensearch_foundation = false
opensearch_collection_prefix = "ask-david"

# Goal 4 is inert by default. Set bootstrap only for the separately reviewed
# initial-role plan. Keep self-assumption false until that apply succeeds; then
# set it true for a separately reviewed trust-policy-only plan. Set active only
# after the trust-policy apply and storage-credential validation both pass.
goal_4_stage = "disabled"
goal_4_storage_role_self_assumption_enabled = false

# Required only when goal_4_stage is bootstrap or active. Keep OAuth tokens in
# the operating-system keyring used by the named CLI profiles; never place them here.
# databricks_workspace_host              = "https://dbc-REPLACE.cloud.databricks.com"
# databricks_workspace_profile           = "ask-david-development"
# databricks_account_profile             = "ask-david-account"
# databricks_account_id                  = "00000000-0000-0000-0000-000000000000"
# databricks_workspace_id                = 1234567890123456
# databricks_metastore_id                = "00000000-0000-0000-0000-000000000000"
# databricks_sql_warehouse_id            = "REPLACE_WITH_APPROVED_WAREHOUSE_ID"
# databricks_governance_admin_user_name  = "REPLACE_WITH_EXISTING_ACCOUNT_USER"
# databricks_catalog_name                = "ask_david_development"
